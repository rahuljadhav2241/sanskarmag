# ==========================================
# SanskarMag / The Success World - Environment Variables
# ==========================================

# Port (Defaults to 3000)
PORT=3000
NODE_ENV=production

# Sanity CMS Public Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=0ju83vao
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity Write Token (Required for suggestions, nominations, and mutations)
SANITY_WRITE_TOKEN=your_sanity_write_token_here

# Google Gemini AI Integration (Required for AI chat assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
